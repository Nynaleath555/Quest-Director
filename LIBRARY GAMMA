const QUEST_DIRECTOR_ENABLED = true;

/*
Chance of asking the model to SEARCH FOR A NEW QUEST on an eligible turn.

0.10 = rare
0.20 = occasional / balanced
0.30 = frequent
*/
const QUEST_ACTIVATION_CHANCE = 0.22;

/*
Minimum number of turns between new-quest searches.
Active quests are still checked for completion every turn.
*/
const MIN_TURNS_BETWEEN_EVALUATIONS = 6;

/*
Maximum number of active quests at once.
*/
const MAX_ACTIVE_QUESTS = 3;

/*
How many completed quests are remembered for duplicate prevention.
*/
const MAX_COMPLETED_QUESTS = 24;

/*
How long a quest can remain active.

0 = quests never expire.
*/
const QUEST_EXPIRATION_TURNS = 80;

/*
Allow the model to create main-story quests.
*/
const ALLOW_MAIN_STORY_QUESTS = true;

/*
Allow the model to create side quests.
*/
const ALLOW_SIDE_QUESTS = true;

/*
Allow quests to naturally lead into follow-up quests.
*/
const ALLOW_QUEST_CHAINS = true;

/*
Maximum chain depth.
0 = original quest
1 = first follow-up
2 = second follow-up
3 = third follow-up
*/
const MAX_CHAIN_DEPTH = 3;

/*
Minimum confidence required before the script accepts a new quest.
*/
const MIN_QUEST_SCORE = 72;

/*
Higher threshold required for a quest chain.
*/
const MIN_CHAIN_SCORE = 82;

/*
"auto" = match the dominant English/Spanish language of the story.
You can force "en" or "es".
*/
const QUEST_LANGUAGE = "auto";

/*
Show the managed Active Quests Story Card.

false = the quest system still works,
but no quest display card is maintained.
*/
const SHOW_QUEST_DISPLAY = true;

/*
Useful while testing.
*/
const QUEST_DIRECTOR_DEBUG = false;

/*
Context limits.

These keep the global Story Card scan useful without filling the
model context with unnecessary duplicate information.
*/
const WORLD_INDEX_MAX_CHARS = 7000;
const INTEGRATION_MAX_CHARS = 4000;

/*
Keep the visible quest card comfortably small.
*/
const DISPLAY_MAX_CHARS = 900;


