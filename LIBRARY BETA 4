/* ============================================================
   HELPERS
   ============================================================ */

function QD_String(value) {
  return String(value ?? "");
}


function QD_Clean(value) {
  return QD_String(value)
    .replace(/\s+/g, " ")
    .trim();
}


function QD_Lower(value) {
  return QD_Clean(value).toLowerCase();
}


function QD_Normalize(value) {
  return QD_Lower(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}


function QD_Limit(value, max) {
  const text = QD_String(value);

  if (text.length <= max) {
    return text;
  }

  return text
    .slice(0, Math.max(0, max - 1))
    .trimEnd() + "…";
}


function QD_Number(value, fallback = 0) {
  const number = Number(value);

  return Number.isFinite(number)
    ? number
    : fallback;
}


function QD_Clamp(value, min, max) {
  return Math.max(
    min,
    Math.min(
      max,
      QD_Number(value, min)
    )
  );
}


function QD_Turn() {
  const actionCount =
    typeof info !== "undefined" &&
    info
      ? Number(info.actionCount)
      : NaN;

  if (Number.isFinite(actionCount)) {
    return actionCount;
  }

  return Array.isArray(history)
    ? history.length
    : 0;
}


function QD_Log(...args) {
  if (!QUEST_DIRECTOR_DEBUG) {
    return;
  }

  try {
    log(
      "[Quest Director]",
      ...args
    );
  } catch (_) {}
}


/* ============================================================
   STATE
   ============================================================ */

function QD_CreateState() {
  return {
    version: QD_VERSION,

    activeQuests: [],

    completedQuests: [],

    expiredQuests: [],

    lastQuestTurn: -999999,

    nextQuestNumber: 1,

    displayLanguage: "en",

    pendingEvaluation: null
  };
}


function QD_GetState() {
  if (
    !state ||
    typeof state !== "object"
  ) {
    return null;
  }

  if (
    !state[QD_STATE_KEY] ||
    typeof state[QD_STATE_KEY] !== "object"
  ) {
    state[QD_STATE_KEY] =
      QD_CreateState();
  }

  const s =
    state[QD_STATE_KEY];

  if (!Array.isArray(s.activeQuests)) {
    s.activeQuests = [];
  }

  if (!Array.isArray(s.completedQuests)) {
    s.completedQuests = [];
  }

  if (!Array.isArray(s.expiredQuests)) {
    s.expiredQuests = [];
  }

  if (
    !Number.isFinite(
      Number(s.lastQuestTurn)
    )
  ) {
    s.lastQuestTurn = -999999;
  }

  if (
    !Number.isFinite(
      Number(s.nextQuestNumber)
    )
  ) {
    s.nextQuestNumber = 1;
  }

  if (
    s.displayLanguage !== "es" &&
    s.displayLanguage !== "en"
  ) {
    s.displayLanguage = "en";
  }

  return s;
}


function QD_NewQuestId(s, turn) {
  const number =
    Math.max(
      1,
      Math.floor(
        QD_Number(
          s.nextQuestNumber,
          1
        )
      )
    );

  s.nextQuestNumber =
    number + 1;

  return `QD-${turn}-${number}`;
}


/* ============================================================
   QUEST MAINTENANCE
   ============================================================ */

function QD_ExpireOldQuests(
  s,
  turn
) {
  if (
    QUEST_EXPIRATION_TURNS <= 0
  ) {
    return false;
  }

  let changed = false;

  const remaining = [];

  for (
    const quest
    of s.activeQuests
  ) {
    const createdTurn =
      QD_Number(
        quest.createdTurn,
        turn
      );

    if (
      turn - createdTurn >=
      QUEST_EXPIRATION_TURNS
    ) {
      s.expiredQuests.push({
        id: quest.id,
        title: quest.title,
        turn
      });

      changed = true;
    } else {
      remaining.push(
        quest
      );
    }
  }

  s.activeQuests =
    remaining;

  s.expiredQuests =
    s.expiredQuests.slice(
      -MAX_COMPLETED_QUESTS
    );

  return changed;
}


function QD_RecordCompletion(
  s,
  quest,
  turn,
  reason
) {
  s.completedQuests.push({
    id: quest.id,

    title: quest.title,

    objective: quest.objective,

    kind: quest.kind,

    completedTurn: turn,

    reason:
      QD_Limit(
        reason ||
          "Objective completed.",
        220
      )
  });

  s.completedQuests =
    s.completedQuests.slice(
      -MAX_COMPLETED_QUESTS
    );
}


function QD_IsDuplicateQuest(
  s,
  title,
  objective
) {
  const titleKey =
    QD_Normalize(title);

  const objectiveKey =
    QD_Normalize(objective);

  if (
    !titleKey ||
    !objectiveKey
  ) {
    return true;
  }

  for (
    const quest
    of s.activeQuests
  ) {
    const qTitle =
      QD_Normalize(
        quest.title
      );

    const qObjective =
      QD_Normalize(
        quest.objective
      );

    if (
      qTitle === titleKey ||
      qObjective === objectiveKey ||
      (
        qTitle &&
        (
          titleKey.includes(qTitle) ||
          qTitle.includes(titleKey)
        )
      )
    ) {
      return true;
    }
  }

  for (
    const quest
    of s.completedQuests
  ) {
    const qTitle =
      QD_Normalize(
        quest.title
      );

    const qObjective =
      QD_Normalize(
        quest.objective
      );

    if (
      qTitle === titleKey ||
      qObjective === objectiveKey
    ) {
      return true;
    }
  }

  for (
    const quest
    of s.expiredQuests
  ) {
    const qTitle =
      QD_Normalize(
        quest.title
      );

    if (
      qTitle === titleKey
    ) {
      return true;
    }
  }

  return false;
}


/* ============================================================
   STORY CARD WORLD INDEX
   ============================================================ */

function QD_IsOwnDisplayCard(
  card
) {
  return !!(
    card &&
    QD_Clean(card.keys) ===
      QD_DISPLAY_KEY
  );
}


function QD_BuildWorldIndex() {
  if (
    !Array.isArray(
      storyCards
    )
  ) {
    return "";
  }

  const rows = [];

  let total = 0;

  for (
    let index = 0;
    index < storyCards.length;
    index++
  ) {
    const card =
      storyCards[index];

    if (
      !card ||
      QD_IsOwnDisplayCard(card)
    ) {
      continue;
    }

    const title =
      QD_Clean(
        card.title ||
        card.name ||
        (
          QD_Clean(
            card.keys
          ).split(",")[0]
          ||
          `Card ${index + 1}`
        )
      );

    const keys =
      QD_Limit(
        card.keys,
        140
      );

    const type =
      QD_Limit(
        card.type,
        50
      );

    const entry =
      QD_Limit(
        card.entry,
        170
      );

    const line =
      `[SC] ${QD_Limit(title, 100)}` +
      ` | keys: ${keys || "—"}` +
      ` | type: ${type || "—"}` +
      ` | entry: ${entry || "—"}`;

    if (
      total +
        line.length +
        1 >
      WORLD_INDEX_MAX_CHARS
    ) {
      break;
    }

    rows.push(line);

    total +=
      line.length + 1;
  }

  return rows.join("\n");
}


/* ============================================================
   INTEGRATION: INNER SELF
   ============================================================ */

function QD_ReadInnerSelf() {
  const rows = [];

  /*
  Only called when INNER_SELF_INSTALLED === true.
  */

  if (
    state &&
    state.InnerSelf &&
    typeof state.InnerSelf === "object"
  ) {
    const inner =
      state.InnerSelf;

    if (
      typeof inner.agent === "string" &&
      inner.agent.trim()
    ) {
      rows.push(
        `[IS] active agent: ` +
        QD_Limit(
          inner.agent,
          100
        )
      );
    }
  }

  if (
    !Array.isArray(
      storyCards
    )
  ) {
    return rows.join("\n");
  }

  let brainCount = 0;

  for (
    const card
    of storyCards
  ) {
    if (
      brainCount >= 6
    ) {
      break;
    }

    if (
      !card ||
      QD_String(
        card.type
      ) !== "Brain"
    ) {
      continue;
    }

    let agent =
      QD_Clean(
        card.title
      );

    try {
      const keys =
        QD_Clean(
          card.keys
        );

      if (
        keys.startsWith("{")
      ) {
        const parsed =
          JSON.parse(keys);

        if (
          parsed &&
          typeof parsed.agent ===
            "string"
        ) {
          agent =
            QD_Clean(
              parsed.agent
            ) || agent;
        }
      }
    } catch (_) {}

    if (!agent) {
      continue;
    }

    /*
    Inner Self Brain cards use their card data to hold
    the character's evolving internal information.
    Keep only a tiny excerpt here.
    */

    const brainData =
      card.description ||
      card.notes ||
      "";

    rows.push(
      `[IS] ${QD_Limit(agent, 80)}` +
      (
        brainData
          ? ` | brain: ${QD_Limit(brainData, 240)}`
          : ""
      )
    );

    brainCount++;
  }

  return rows.join("\n");
}


/* ============================================================
   INTEGRATION: AUTO-CARDS
   ============================================================ */

function QD_ReadAutoCards() {
  /*
  Only called when AUTO_CARDS_INSTALLED === true.
  */

  if (
    typeof AutoCards !==
      "function"
  ) {
    return "";
  }

  try {
    const root =
      AutoCards();

    const api =
      root &&
      root.API;

    if (
      api &&
      typeof api.getUsedTitles ===
        "function"
    ) {
      const titles =
        api.getUsedTitles();

      if (
        Array.isArray(
          titles
        )
      ) {
        const cleanTitles =
          titles
            .slice(0, 24)
            .map(QD_Clean)
            .filter(Boolean);

        if (
          cleanTitles.length
        ) {
          return (
            "[AC] known card titles: " +
            cleanTitles.join(
              " | "
            )
          );
        }
      }
    }
  } catch (_) {}

  return "";
}


/* ============================================================
   INTEGRATION: BASIC REL
   ============================================================ */

function QD_ReadBasicREL() {
  /*
  Only called when BASIC_REL_INSTALLED === true.
  */

  const relationships =
    state &&
    state.relationships &&
    typeof state.relationships ===
      "object"
      ? state.relationships
      : null;

  if (
    !relationships ||
    !relationships.characters ||
    typeof relationships.characters !==
      "object"
  ) {
    return "";
  }

  const activeNames =
    relationships.sceneTracker &&
    Array.isArray(
      relationships
        .sceneTracker
        .activeNames
    )
      ? relationships
          .sceneTracker
          .activeNames
      : [];

  const characters =
    Object.entries(
      relationships.characters
    )
      .sort(
        (a, b) => {
          const aActive =
            activeNames.includes(
              a[0]
            )
              ? 1
              : 0;

          const bActive =
            activeNames.includes(
              b[0]
            )
              ? 1
              : 0;

          return (
            bActive -
            aActive
          );
        }
      )
      .slice(0, 8);

  const rows = [];

  for (
    const [
      name,
      data
    ]
    of characters
  ) {
    if (
      !data ||
      typeof data !==
        "object"
    ) {
      continue;
    }

    const friendship =
      QD_Number(
        data.friendship,
        0
      );

    const romance =
      QD_Number(
        data.romance,
        0
      );

    const active =
      activeNames.includes(
        name
      )
        ? " | active scene"
        : "";

    rows.push(
      `[REL] ${QD_Limit(name, 70)}` +
      ` | friendship: ${friendship}` +
      ` | romance: ${romance}` +
      active
    );
  }

  return rows.join("\n");
}


/* ============================================================
   INTEGRATION: NPC SPAWN SYSTEM
   ============================================================ */

function QD_ReadNPCSpawn() {
  /*
  Only called when NPC_SPAWN_SYSTEM_INSTALLED === true.
  Quest Director observes NPC Spawn state.
  It does NOT control spawning.
  */

  const npc =
    state &&
    state.npcSpawn &&
    typeof state.npcSpawn ===
      "object"
      ? state.npcSpawn
      : null;

  if (!npc) {
    return "";
  }

  const rows = [];

  if (
    npc.currentLocation
  ) {
    rows.push(
      `[NPC] current location: ` +
      QD_Limit(
        npc.currentLocation,
        120
      )
    );
  }

  if (
    npc.lastEntry &&
    typeof npc.lastEntry ===
      "object"
  ) {
    rows.push(
      `[NPC] last entry: ` +
      QD_Limit(
        npc.lastEntry.location,
        100
      ) +
      ` | ${QD_Limit(
        npc.lastEntry.type,
        40
      )}` +
      ` | turn ${QD_Number(
        npc.lastEntry.turn,
        0
      )}`
    );
  }

  if (
    npc.recentPresence &&
    typeof npc.recentPresence ===
      "object"
  ) {
    const names =
      Object.keys(
        npc.recentPresence
      ).slice(0, 10);

    if (names.length) {
      rows.push(
        "[NPC] recent presence: " +
        names.join(" | ")
      );
    }
  }

  return rows.join("\n");
}


/* ============================================================
   INTEGRATION: EVENT PARADOX
   ============================================================ */

function QD_SummarizeObject(
  value,
  depth = 0,
  budget = 1400
) {
  if (
    budget <= 0 ||
    depth > 2 ||
    value === null ||
    value === undefined
  ) {
    return "";
  }

  if (
    typeof value === "string" ||
    typeof value === "number" ||
    typeof value === "boolean"
  ) {
    return QD_Limit(
      QD_String(value),
      Math.min(
        240,
        budget
      )
    );
  }

  if (
    Array.isArray(value)
  ) {
    const parts = [];

    let used = 0;

    for (
      const item
      of value.slice(0, 12)
    ) {
      const part =
        QD_SummarizeObject(
          item,
          depth + 1,
          180
        );

      if (!part) {
        continue;
      }

      if (
        used +
          part.length +
          3 >
        budget
      ) {
        break;
      }

      parts.push(part);

      used +=
        part.length + 3;
    }

    return parts.join(
      " | "
    );
  }

  if (
    typeof value ===
      "object"
  ) {
    const parts = [];

    let used = 0;

    for (
      const [
        key,
        item
      ]
      of Object.entries(
        value
      ).slice(0, 18)
    ) {
      const lowerKey =
        QD_Lower(key);

      const relevant =
        depth === 0 ||
        /^(chapter|currentchapter|time|currenttime|variables|flags|entities|consequences|paths|memory|events|status|location|active|current)$/
          .test(
            lowerKey
          );

      if (!relevant) {
        continue;
      }

      const part =
        QD_SummarizeObject(
          item,
          depth + 1,
          220
        );

      if (!part) {
        continue;
      }

      const line =
        `${key}=${part}`;

      if (
        used +
          line.length +
          2 >
        budget
      ) {
        break;
      }

      parts.push(line);

      used +=
        line.length + 2;
    }

    return parts.join(
      "; "
    );
  }

  return "";
}


function QD_ReadEventParadox() {
  /*
  Only called when EVENT_PARADOX_INSTALLED === true.

  Event Paradox remains the authority over deterministic
  events, chapters and consequences.

  Quest Director reads state only.
  */

  const ep =
    state &&
    state.eventParadox &&
    typeof state.eventParadox ===
      "object"
      ? state.eventParadox
      : null;

  if (!ep) {
    return "";
  }

  const summary =
    QD_SummarizeObject(
      ep,
      0,
      1400
    );

  return summary
    ? `[EP] ${summary}`
    : "";
}


/* ============================================================
   INTEGRATION: KARMA
   ============================================================ */

function QD_ReadKarma() {
  /*
  Only called when KARMA_SYSTEM_INSTALLED === true.
  */

  if (
    typeof AID_KARMA ===
      "undefined" ||
    !AID_KARMA ||
    typeof AID_KARMA.status !==
      "function"
  ) {
    return "";
  }

  try {
    const raw =
      AID_KARMA.status();

    if (!raw) {
      return "";
    }

    if (
      typeof raw ===
        "string"
    ) {
      return (
        "[KARMA] " +
        QD_Limit(
          raw,
          1200
        )
      );
    }

    if (
      typeof raw ===
        "object"
    ) {
      const wanted = [
        "karma",
        "publicScore",
        "reputation",
        "publicPerception",
        "authorities",
        "alignment",
        "moralAlignment",
        "knownDeeds",
        "deeds"
      ];

      const parts = [];

      for (
        const key
        of wanted
      ) {
        if (
          !(key in raw)
        ) {
          continue;
        }

        const value =
          raw[key];

        if (
          Array.isArray(
            value
          )
        ) {
          parts.push(
            `${key}=[` +
            value
              .slice(-4)
              .map(
                QD_Clean
              )
              .join(" | ") +
            "]"
          );
        } else if (
          value &&
          typeof value ===
            "object"
        ) {
          parts.push(
            `${key}=` +
            QD_SummarizeObject(
              value,
              1,
              260
            )
          );
        } else {
          parts.push(
            `${key}=` +
            QD_Clean(
              value
            )
          );
        }
      }

      return parts.length
        ? (
            "[KARMA] " +
            QD_Limit(
              parts.join("; "),
              1200
            )
          )
        : "";
    }
  } catch (_) {}

  return "";
}


/* ============================================================
   BUILD OPTIONAL SYSTEM INDEX
   ============================================================ */

function QD_BuildIntegrationIndex() {
  const rows = [];

  /*
  IMPORTANT:
  Every external script reference is reached only from inside
  its explicit INSTALLED === true guard.
  */

  if (
    INNER_SELF_INSTALLED
  ) {
    const value =
      QD_ReadInnerSelf();

    if (value) {
      rows.push(
        value
      );
    }
  }

  if (
    AUTO_CARDS_INSTALLED
  ) {
    const value =
      QD_ReadAutoCards();

    if (value) {
      rows.push(
        value
      );
    }
  }

  if (
    BASIC_REL_INSTALLED
  ) {
    const value =
      QD_ReadBasicREL();

    if (value) {
      rows.push(
        value
      );
    }
  }

  if (
    NPC_SPAWN_SYSTEM_INSTALLED
  ) {
    const value =
      QD_ReadNPCSpawn();

    if (value) {
      rows.push(
        value
      );
    }
  }

  if (
    EVENT_PARADOX_INSTALLED
  ) {
    const value =
      QD_ReadEventParadox();

    if (value) {
      rows.push(
        value
      );
    }
  }

  if (
    KARMA_SYSTEM_INSTALLED
  ) {
    const value =
      QD_ReadKarma();

    if (value) {
      rows.push(
        value
      );
    }
  }

  return QD_Limit(
    rows.join("\n"),
    INTEGRATION_MAX_CHARS
  );
}


/* ============================================================
   QUEST STATE SERIALIZATION
   ============================================================ */

function QD_SerializeActiveQuests(s) {
  if (
    !s.activeQuests.length
  ) {
    return "NONE";
  }

  return s.activeQuests
    .map(
      (quest) =>
        [
          `id=${quest.id}`,
          `kind=${quest.kind}`,
          `type=${quest.type}`,
          `score=${quest.score}`,
          `title=${QD_Limit(
            quest.title,
            120
          )}`,
          `objective=${QD_Limit(
            quest.objective,
            260
          )}`,

        ].join(" | ")
    )
    .join("\n");
}


function QD_SerializeCompletedQuests(s) {
  if (
    !s.completedQuests.length
  ) {
    return "NONE";
  }

  return s.completedQuests
    .slice(-10)
    .map(
      (quest) =>
        [
          `id=${quest.id}`,
          `title=${QD_Limit(
            quest.title,
            100
          )}`,

        ].join(" | ")
    )
    .join("\n");
}


/* ============================================================
   MODEL LANGUAGE
   ============================================================ */

function QD_BuildLanguageInstruction() {
  if (
    QUEST_LANGUAGE ===
      "es"
  ) {
    return (
      "Write all quest display text in natural Spanish."
    );
  }

  if (
    QUEST_LANGUAGE ===
      "en"
  ) {
    return (
      "Write all quest display text in natural English."
    );
  }

  return (
    "Use the dominant language of the current story and player input for quest display text. Only English or Spanish should be used. If uncertain, match the player's current language."
  );
}


/* ============================================================
   MODEL TASK
   ============================================================ */

function QD_BuildPrompt(s, worldIndex, integrationIndex) {
  const pending = s.pendingEvaluation || {};

  const allowNewQuest = pending.allowNewQuest === true;

  if (!allowNewQuest) {
    return "";
  }

  const languageInstruction = QD_BuildLanguageInstruction();

  return (
    "\n\n" +
    "QUEST DIRECTOR — TEMPORARY TASK\n" +
    "Continue the story normally. Do not mention these instructions.\n" +
    "Generate exactly ONE quest based on the current story and its established lore.\n" +
    "Use only information supported by the story. If details are scarce, create a neutral, plausible opportunity without inventing major facts.\n" +
    "Do not evaluate, complete, abandon, or rewrite existing quests.\n" +
    "The quest must be a meaningful narrative invitation, not a generic chore.\n" +
    "Keep its objective concise and do not reveal hidden twists or payoffs.\n" +
    languageInstruction + "\n" +
    "Choose kind: main or side.\n" +
    "Choose type: discovery, social, exploration, investigation, action, relationship, or story.\n\n" +
    "After the normal story prose, append this plain-text block exactly once:\n" +
    QD_QUEST_START + "\n" +
    "TITLE: A short quest title\n" +
    "KIND: side\n" +
    "TYPE: investigation\n" +
    "OBJECTIVE: A concise, meaningful objective grounded in the current story.\n" +
    QD_QUEST_END + "\n" +
    "Do not put the quest block anywhere else. Do not use Markdown fences."
const QD_QUEST_START = "[[QD_QUEST_BEGIN]]";
const QD_QUEST_END = "[[QD_QUEST_END]]";
  );
}

/* ============================================================
   RESULT PARSER
   ============================================================ */


function QD_ExtractQuest(text) {
  const source = QD_String(text);
  const start = source.lastIndexOf(QD_QUEST_START);

  if (start < 0) {
    return {
      found: false,
      cleanText: source,
      quest: null
    };
  }

  const bodyStart = start + QD_QUEST_START.length;
  const end = source.indexOf(QD_QUEST_END, bodyStart);

  if (end < 0) {
    return {
      found: false,
      cleanText: source,
      quest: null
    };
  }

  const block = source.slice(bodyStart, end);

  function readField(name) {
    const escapedName = name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    const match = block.match(
      new RegExp("(?:^|\\n)\\s*" + escapedName + "\\s*:\\s*(.*)", "i")
    );

    return match ? QD_Clean(match[1]) : "";
  }

  const quest = {
    title: readField("TITLE"),
    kind: readField("KIND"),
    type: readField("TYPE"),
    objective: readField("OBJECTIVE")
  };

  const cleanText = (
    source.slice(0, start) +
    source.slice(end + QD_QUEST_END.length)
  ).trim();

  return {
    found: true,
    cleanText,
    quest
  };
}


/* ============================================================
   QUEST VALIDATION
   ============================================================ */

function QD_ValidQuestCandidate(candidate) {
  if (
    !candidate ||
    typeof candidate !== "object"
  ) {
    return false;
  }

  candidate.title =
    QD_Clean(candidate.title);

  candidate.objective =
    QD_Clean(candidate.objective);

  if (
    candidate.title.length < 2 ||
    candidate.objective.length < 4
  ) {
    return false;
  }

  let kind =
    QD_Lower(candidate.kind) || "side";

  let type =
    QD_Lower(candidate.type) || "story";

  if (
    !["main", "side"].includes(kind)
  ) {
    kind = "side";
  }

  if (
    !QD_VALID_TYPES.includes(type)
  ) {
    type = "story";
  }

  if (
    kind === "main" &&
    !ALLOW_MAIN_STORY_QUESTS
  ) {
    kind = "side";
  }

  if (
    kind === "side" &&
    !ALLOW_SIDE_QUESTS
  ) {
    kind = "main";
  }

  if (
    (kind === "main" && !ALLOW_MAIN_STORY_QUESTS) ||
    (kind === "side" && !ALLOW_SIDE_QUESTS)
  ) {
    return false;
  }

  candidate.kind = kind;
  candidate.type = type;

  return true;
}


/* ============================================================
   APPLY MODEL RESULT
   ============================================================ */

function QD_ApplyResult(s, candidate, turn) {
  if (!s || !candidate || typeof candidate !== "object") {
    return false;
  }


  if (
    !s.pendingEvaluation ||
    s.pendingEvaluation.allowNewQuest !== true
  ) {
    return false;
  }

 
  if (s.activeQuests.length >= MAX_ACTIVE_QUESTS) {
    QD_Log("Quest not created: active quest limit reached.");
    return false;
  }

  candidate.title = QD_Limit(QD_Clean(candidate.title), 140);
  candidate.objective = QD_Limit(QD_Clean(candidate.objective), 320);

  let kind = QD_Lower(candidate.kind);
  let type = QD_Lower(candidate.type);

  if (!["main", "side"].includes(kind)) {
    kind = "side";
  }

  if (!QD_VALID_TYPES.includes(type)) {
    type = "story";
  }

  if (kind === "main" && !ALLOW_MAIN_STORY_QUESTS) {
    kind = "side";
  }

  if (kind === "side" && !ALLOW_SIDE_QUESTS) {
    kind = "main";
  }

  if (
    (kind === "main" && !ALLOW_MAIN_STORY_QUESTS) ||
    (kind === "side" && !ALLOW_SIDE_QUESTS)
  ) {
    QD_Log("Quest not created: both quest kinds are disabled.");
    return false;
  }

  if (candidate.title.length < 2) {
    candidate.title = "Una oportunidad inesperada";
  }

  if (candidate.objective.length < 4) {
    candidate.objective =
      "Presta atención a lo ocurrido recientemente y descubre qué oportunidad narrativa puede surgir de ello.";
  }

  const quest = {
    id: QD_NewQuestId(s, turn),
    title: candidate.title,
    objective: candidate.objective,
    kind,
    type,
    score: 50,
    reason: "Generated from the current story.",
    createdTurn: turn,
    expiresTurn:
      QUEST_EXPIRATION_TURNS > 0
        ? turn + QUEST_EXPIRATION_TURNS
        : null
  };

  s.activeQuests.push(quest);
  s.lastQuestTurn = turn;

  QD_Log("Created quest.", quest);
  return true;
}


/* ============================================================
   DISPLAY CARD
   ============================================================ */

function QD_FindDisplayCard() {
  if (
    !Array.isArray(storyCards)
  ) {
    return null;
  }

  for (
    let index = 0;
    index < storyCards.length;
    index++
  ) {
    if (
      QD_IsOwnDisplayCard(
        storyCards[index]
      )
    ) {
      return {
        card: storyCards[index],
        index
      };
    }
  }

  return null;
}


function QD_BuildDisplayText(s) {
  if (
    !s.activeQuests.length
  ) {
    return "";
  }

  const spanish =
    s.displayLanguage === "es";

  const lines = [];

  lines.push(
    spanish
      ? "📜 Misiones activas"
      : "📜 Active Quests"
  );

  lines.push("");

  for (
    const quest
    of s.activeQuests
  ) {
    const label =
      quest.kind === "main"
        ? (
            spanish
              ? "Principal"
              : "Main"
          )
        : (
            spanish
              ? "Secundaria"
              : "Side"
          );

    lines.push(
      `• ${QD_Limit(
        quest.title,
        90
      )} (${label})`
    );

    lines.push(
      QD_Limit(
        quest.objective,
        280
      )
    );

    lines.push("");
  }

  lines.push(
    spanish
      ? "Las misiones son oportunidades narrativas opcionales. La historia decide qué ocurre después."
      : "Quests are optional narrative opportunities. The story decides what happens next."
  );

  return QD_Limit(
    lines.join("\n"),
    DISPLAY_MAX_CHARS
  );
}


function QD_UpdateDisplayCard(s) {
  const existing = QD_FindDisplayCard();

  QD_Log("Display card sync started.",{
    enabled:SHOW_QUEST_DISPLAY,
    activeQuests:s.activeQuests.length,
    existingCard:!!existing,
    storyCardsAvailable:Array.isArray(storyCards)
  });

  if (!SHOW_QUEST_DISPLAY || !s.activeQuests.length) {
    if (existing) {
      try {
        removeStoryCard(existing.index);
        QD_Log("Display card removed.",{index:existing.index});
      } catch (error) {
        QD_Log("Display card removal failed.",error);
      }
    }
    return;
  }

  const entry =
    QD_BuildDisplayText(s);

  const title =
    s.displayLanguage === "es"
      ? "📜 Misiones activas"
      : "📜 Active Quests";

  try {
    if (existing) {
      updateStoryCard(
        existing.index,
        QD_DISPLAY_KEY,
        entry,
        QD_DISPLAY_TYPE
      );

      if (storyCards[existing.index]) {
        storyCards[existing.index].title = title;
      }

      QD_Log("Display card updated.",{
        index:existing.index,
        title,
        entryLength:entry.length
      });

      return;
    }

    const newIndex =
      addStoryCard(
        QD_DISPLAY_KEY,
        entry,
        QD_DISPLAY_TYPE
      );

    if (
      newIndex !== false &&
      Number.isInteger(Number(newIndex)) &&
      storyCards[Number(newIndex)]
    ) {
      storyCards[Number(newIndex)].title = title;

      QD_Log("Display card created.",{
        index:Number(newIndex),
        title,
        entryLength:entry.length
      });
    } else {
      QD_Log("Display card creation returned an unexpected index.",newIndex);
    }
  } catch (error) {
    QD_Log(
      "Display card error",
      error
    );
  }
}


/* ============================================================
   PUBLIC QUEST DIRECTOR API
   ============================================================ */

const QuestDirector = {
  version: QD_VERSION,

  /* ----------------------------------------------------------
     INPUT HOOK
     ---------------------------------------------------------- */

  input(text) {
    const s =
      QD_GetState();

    if (
      !s ||
      !QUEST_DIRECTOR_ENABLED
    ) {
      return text;
    }

    const turn =
      QD_Turn();

    const expired =
      QD_ExpireOldQuests(
        s,
        turn
      );

    /*
    Completion checks are independent of new-quest activation.
    Existing active quests need evaluation even when the
    activation roll fails or the creation cooldown is active.
    */

    s.pendingEvaluation = null;

    const cooldownFinished =
      turn -
        s.lastQuestTurn >=
      MIN_TURNS_BETWEEN_QUESTS;

    const activationRoll =
      Math.random();

    const activationChance =
      QD_Clamp(
        QUEST_ACTIVATION_CHANCE,
        0,
        1
      );

    const capacityAvailable =
      s.activeQuests.length <
        MAX_ACTIVE_QUESTS;

    const allowNewQuest =
      cooldownFinished &&
      capacityAvailable &&
      activationRoll < activationChance;

    const shouldEvaluate =
      allowNewQuest ||
      s.activeQuests.length > 0;

    QD_Log(
      "Input evaluation decision.",
      {
        turn,
        activeQuests:s.activeQuests.length,
        expired,
        cooldownFinished,
        turnsSinceLastQuest:turn - s.lastQuestTurn,
        activationChance,
        activationRoll,
        capacityAvailable,
        allowNewQuest,
        shouldEvaluate
      }
    );

    if (shouldEvaluate) {
      s.pendingEvaluation = {
        turn,
        allowNewQuest
      };

      QD_Log(
        "Evaluation queued.",
        s.pendingEvaluation
      );
    } else {
      QD_Log(
        "Evaluation not queued: no active quests and no new-quest activation.",
        {turn}
      );
    }

    /*
    Display maintenance is local script work.
    It does not request an AI generation.
    */

    if (
      !SHOW_QUEST_DISPLAY ||
      expired ||
      (
        s.activeQuests.length > 0 &&
        !QD_FindDisplayCard()
      )
    ) {
      QD_UpdateDisplayCard(s);
    }

    return text;
  },


  /* ----------------------------------------------------------
     CONTEXT HOOK
     ---------------------------------------------------------- */

 
context(text) {
  const s = QD_GetState();

  if (!s || !QUEST_DIRECTOR_ENABLED) {
    return { text, stop: false };
  }

  if (
    !s.pendingEvaluation ||
    s.pendingEvaluation.allowNewQuest !== true
  ) {
    return { text, stop: false };
  }

  const prompt = QD_BuildPrompt(s, "", "");

  if (!prompt) {
    return { text, stop: false };
  }

  QD_Log("Temporary quest-generation instruction injected.", {
    turn: s.pendingEvaluation.turn
  });

  return {
    text: QD_String(text) + "\n\n" + prompt,
    stop: false
  };
},


  /* ----------------------------------------------------------
     OUTPUT HOOK
     ---------------------------------------------------------- */

 
output(text) {
  const s = QD_GetState();

  if (!s || !QUEST_DIRECTOR_ENABLED) {
    return text || "\u200B";
  }

  const turn = QD_Turn();

  QD_ExpireOldQuests(s, turn);

  const parsed = QD_ExtractQuest(text);

  try {
    if (
      parsed.found &&
      parsed.quest &&
      s.pendingEvaluation &&
      s.pendingEvaluation.allowNewQuest === true
    ) {
      QD_ApplyResult(s, parsed.quest, turn);
    } else if (
      s.pendingEvaluation &&
      s.pendingEvaluation.allowNewQuest === true
    ) {
      // Fallback local si el modelo no devuelve el bloque esperado.
      QD_ApplyResult(s, {
        title: "Una oportunidad inesperada",
        kind: "side",
        type: "story",
        objective:
          "Presta atención a las consecuencias de lo ocurrido recientemente y descubre qué oportunidad narrativa se abre."
      }, turn);
    }

    QD_UpdateDisplayCard(s);
  } catch (error) {
    QD_Log("Output processing error.", error);
  }

  s.pendingEvaluation = null;

  return parsed.found
    ? (parsed.cleanText || "\u200B")
    : (text || "\u200B");
},


  /* ----------------------------------------------------------
     DISPLAY SYNC
     ---------------------------------------------------------- */

  syncDisplay() {
    const s =
      QD_GetState();

    if (!s) {
      return;
    }

    QD_UpdateDisplayCard(s);
  },


  /* ----------------------------------------------------------
     STATE ACCESS
     ---------------------------------------------------------- */

  getState() {
    return QD_GetState();
  }
};
